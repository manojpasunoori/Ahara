# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (used by Docker Compose and the API)
POSTGRES_DB=ahara
POSTGRES_USER=ahara
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://ahara:change-me-for-local-development@postgres:5432/ahara

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend (browser-visible URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

AHARA_MODE=demo
PLACES_PROVIDER=foursquare
FOURSQUARE_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Context mode: live uses Open-Meteo; demo uses deterministic Arlington fixture
AHARA_MODE=demo
